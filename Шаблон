&НаКлиенте
Процедура Войти(Команда)
	
	Если Логин = "" ИЛИ Пароль = "" Тогда
		ПоказатьОповещениеПользователя("Заполните все поля!");
		Возврат;
	КонецЕсли;
	
	Результат = ВойтиНаСервере(Логин, Пароль);
	
	Если Результат.Успех Тогда
		Если Результат.СменаПароля Тогда
			ОткрытьФорму("ОбщаяФорма.ФормаСменыПароля", Новый Структура("Пользователь", Результат.Пользователь));
		Иначе            
			Если Результат.Роль = "Пользователь" Тогда
				ОткрытьФорму("ОбщаяФорма.ФормаПользователя");
	        Иначе
	            ПоказатьОповещениеПользователя("Успешная авторизация!");
			КонецЕсли;
			ПоказатьОповещениеПользователя("Успешная авторизация!");
		КонецЕсли;
		Закрыть();
	Иначе
		ПоказатьОповещениеПользователя(Результат.Текст);
	КонецЕсли;
			
КонецПроцедуры

 
 
&НаСервере
Функция ВойтиНаСервере(Логин, Пароль)
	
	Ответ = Новый Структура("Успех, Текст, СменаПароля, Пользователь, Роль", Ложь, "", Ложь, Неопределено, "");

	Запрос = Новый Запрос("Выбрать Ссылка, Пароль, Роль, Активен, ДатаВхода, КоличествоПопыток, СменаПароля ИЗ Справочник.Пользователи ГДЕ Логин = &Логин");
	Запрос.УстановитьПараметр("Логин", Логин);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		Ответ.Текст = "Пользователь не найден!";
		Возврат Ответ;
	КонецЕсли;
	
	Если Не Выборка.Активен Тогда
		Ответ.Текст = "Вы заблокированы!";
		Возврат Ответ;	
	КонецЕсли;
	
	Если Выборка.ДатаВхода <> Дата('00010101') И ТекущаяДата() - Выборка.ДатаВхода >= 30*24*60*60 Тогда
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.Активен = Ложь;
		Объект.Записать();
		Ответ.Текст = "Вы заблокированы";
		Возврат Ответ;
	КонецЕсли;
	
	Если Выборка.Пароль <> Пароль Тогда
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.КоличествоПопыток = Объект.КоличествоПопыток + 1;
		Если Объект.КоличествоПопыток >= 3 Тогда
			Объект.Активен = Ложь;
			Объект.Записать();
			Ответ.Текст = "Вы заблокированы!";
		Иначе
			Объект.Записать();
			Ответ.Текст = "Пароль неверен! попыток:" + (3 - Объект.КоличествоПопыток);
		КонецЕсли;
		Возврат Ответ;
	КонецЕсли;
	
	Объект = Выборка.Ссылка.ПолучитьОбъект();
	Объект.КоличествоПопыток = 0;
	Объект.ДатаВхода = ТекущаяДата();
	Объект.Записать();
	
	Ответ.Успех = Истина;
	Ответ.СменаПароля = (Выборка.ДатаВхода = Дата('00010101')) ИЛИ Выборка.СменаПароля;
	Ответ.Роль = Выборка.Роль;
	Ответ.Пользователь = Выборка.Ссылка;
	Возврат Ответ;
КонецФункции
	
