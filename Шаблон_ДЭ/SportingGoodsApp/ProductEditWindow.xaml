<Window x:Class="SportingGoodsApp.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование товара" Height="550" Width="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" x:Name="imgProduct" Width="100" Height="100" Stretch="Uniform" Margin="5"/>
        <Button Grid.Row="0" Grid.Column="1" Content="Загрузить фото" Width="120" Height="25" Click="LoadImage_Click" Margin="5"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="(макс. 300x200)" FontSize="10" Foreground="Gray" Margin="5,0"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Наименование:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtName" Grid.Row="2" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Описание:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtDescription" Grid.Row="3" Grid.Column="1" Margin="5" Height="60" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Производитель:" VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="cmbManufacturer" Grid.Row="4" Grid.Column="1" Margin="5" DisplayMemberPath="Название" SelectedValuePath="ID_Производители"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Поставщик:" VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="cmbSupplier" Grid.Row="5" Grid.Column="1" Margin="5" DisplayMemberPath="Название" SelectedValuePath="ID_Поставщика"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Цена:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtPrice" Grid.Row="6" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Единица измерения:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtUnit" Grid.Row="7" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Количество на складе:" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtStock" Grid.Row="8" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="9" Grid.Column="0" Text="Скидка (%):" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="txtDiscount" Grid.Row="9" Grid.Column="1" Margin="5"/>

        <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button x:Name="btnSave" Content="Сохранить" Width="80" Margin="5" Click="BtnSave_Click"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="80" Margin="5" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>