<Window x:Class="SportingGoodsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Спортивные товары" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <TextBlock x:Name="tbUserInfo" Text="Пользователь:" VerticalAlignment="Center" Margin="5"/>
            <Button x:Name="btnLogout" Content="Выйти" Width="80" Click="BtnLogout_Click"/>
        </StackPanel>

        <WrapPanel x:Name="panelSearchFilter" Grid.Row="1" Margin="5" Visibility="Collapsed">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="5,0"/>
            <TextBox x:Name="txtSearch" Width="200" Margin="5,0" TextChanged="TxtSearch_TextChanged"/>
            <TextBlock Text="Поставщик:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <ComboBox x:Name="cmbSupplier" Width="150" SelectionChanged="CmbSupplier_SelectionChanged"/>
            <TextBlock Text="Сортировка по кол-ву:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <ComboBox x:Name="cmbSort" Width="120" SelectionChanged="CmbSort_SelectionChanged">
                <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>
        </WrapPanel>

        <StackPanel x:Name="panelAdminButtons" Grid.Row="2" Orientation="Horizontal" Margin="5" Visibility="Collapsed">
            <Button x:Name="btnAdd" Content="Добавить товар" Width="120" Margin="5" Click="BtnAdd_Click"/>
            <Button x:Name="btnEdit" Content="Редактировать" Width="120" Margin="5" Click="BtnEdit_Click" IsEnabled="False"/>
            <Button x:Name="btnDelete" Content="Удалить" Width="100" Margin="5" Click="BtnDelete_Click" IsEnabled="False"/>
            <Button x:Name="btnOrders" Content="Заказы" Width="100" Margin="5" Click="BtnOrders_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="icProducts">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" Margin="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="cardBorder" BorderBrush="DarkGray" BorderThickness="1" CornerRadius="8" Margin="10" Padding="10" Width="550" Background="White" MouseLeftButtonUp="Card_MouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Margin="2" Padding="5" VerticalAlignment="Stretch">
                                    <Image Source="{Binding ПутьКИзображению}" Width="120" Height="120" Stretch="Uniform" VerticalAlignment="Center"/>
                                </Border>

                                <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Margin="2" Padding="5" VerticalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Наименование}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding Описание}" TextWrapping="Wrap" Margin="0,5" FontSize="11" Foreground="Gray"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Производитель:" FontWeight="Bold" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Производитель}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock x:Name="oldPriceBlock" Text="{Binding СтараяЦена}" TextDecorations="Strikethrough" Foreground="Red" Margin="0,0,10,0" Visibility="{Binding ПоказатьСтаруюЦену}"/>
                                            <TextBlock Text="{Binding Цена}" Foreground="Black" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Margin="2" Padding="5" VerticalAlignment="Stretch">
                                    <TextBlock Text="{Binding КолНаСкладе}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding КолНаСкладе}" Value="0">
                                <Setter TargetName="cardBorder" Property="Background" Value="LightGray"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>