                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Margin="2" Padding="5" VerticalAlignment="Stretch">
                                    <Image Source="{Binding ПутьКИзображению}" Width="120" Height="120" Stretch="Uniform" VerticalAlignment="Center"/>
                                </Border>

                                <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Margin="2" Padding="5" VerticalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Наименование}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding Описание}" TextWrapping="Wrap" Margin="0,5" FontSize="11" Foreground="Gray"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock Text="Производитель:" FontWeight="Bold" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Производитель}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <TextBlock x:Name="oldPriceBlock" Text="{Binding СтараяЦена}" TextDecorations="Strikethrough" Foreground="Red" Margin="0,0,10,0" Visibility="{Binding ПоказатьСтаруюЦену}"/>
                                            <TextBlock Text="{Binding Цена}" Foreground="Black" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Margin="2" Padding="5" VerticalAlignment="Stretch">
                                    <TextBlock Text="{Binding КолНаСкладе}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding КолНаСкладе}" Value="0">
                                <Setter TargetName="cardBorder" Property="Background" Value="LightGray"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
